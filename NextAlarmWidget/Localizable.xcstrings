{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@ Sleeping in" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A dormir de más"
          }
        }
      }
    },
    "%@ may need to refresh your alarms" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que %@ tenga que actualizar tus alarmas"
          }
        }
      }
    },
    "%@ needs calendar access to find your first event tomorrow and calculate your wake-up time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita acceso a tu calendario para encontrar tu primer evento de mañana y calcular a qué hora despertarte."
          }
        }
      }
    },
    "Alarm access is off, so %@ can't set your wake-up alarms. Tap to turn it on in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a alarmas está desactivado, así que %@ no puede programar tus alarmas. Toca para activarlo en Configuración."
          }
        }
      }
    },
    "Alarm access lets %@ set your wake-up alarms. Notifications are optional." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a alarmas permite que %@ programe tus alarmas. Las notificaciones son opcionales."
          }
        }
      }
    },
    "Creates a one-time test alarm without changing tomorrow's managed wake-up alarm." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una alarma de prueba única sin cambiar la alarma de mañana."
          }
        }
      }
    },
    "Design Review" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisión de diseño"
          }
        }
      }
    },
